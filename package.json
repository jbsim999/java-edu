{
  "name": "java-edu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Java 공식 문서 기반 전환 학습과 버전별 실무 심화",
  "scripts": {
    "dev": "node scripts/build-editor.mjs && node scripts/serve.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-worker.mjs",
    "test:worker": "node scripts/check-worker.mjs",
    "test:java": "node scripts/check-java.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "node --check dist/app.js && node --check dist/data/curriculum.js && node --check dist/data/job-evidence.js && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@electron/get@3.1.0": {
      "global-agent": "4.1.3"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5"
  }
}
